# Database
DATABASE_URL="postgresql://resumeiq:resumeiq_secret@localhost:5432/airesumeiq?schema=public"

# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI (use Gemini OR OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vector DB (optional - uses in-memory fallback if not set)
PINECONE_API_KEY=
PINECONE_INDEX=resumeiq

# File uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
